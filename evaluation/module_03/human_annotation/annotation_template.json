{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module3CitationAnnotationSchema",
  "type": "object",
  "properties": {
    "annotator_id": { "type": "string" },
    "submission_timestamp": { "type": "string" },
    "citation_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sample_id": { "type": "string" },
          "citation_id": { "type": "string" },
          "support_label": {
            "type": "string",
            "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "NOT_SUPPORTED", "UNVERIFIABLE", "NOT_APPLICABLE"]
          },
          "provenance_intact": { "type": "boolean" },
          "numerical_exact": { "type": ["boolean", "null"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "notes": { "type": "string" }
        },
        "required": ["sample_id", "citation_id", "support_label", "provenance_intact", "confidence"]
      }
    }
  },
  "required": ["annotator_id", "submission_timestamp", "citation_evaluations"]
}
